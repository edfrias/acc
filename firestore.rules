rules_version = '2';

// Generador de carnets (carnets/): plantillas oficiales, una por temporada.
// Solo las cuentas de Google del club (@arquerscastelldefels.com, todas de la junta) pueden leerlas y publicarlas.
// Los datos de los socios nunca llegan aquí: se procesan en el navegador.
service cloud.firestore {
  match /databases/{database}/documents {
    function isClub() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('[^@]+@arquerscastelldefels[.]com');
    }

    // Temporada "2026-27": el segundo año es el siguiente al primero
    function isSeason(id) {
      return id.matches('[0-9]{4}-[0-9]{2}')
        && int(id.split('-')[1]) == (int(id.split('-')[0]) + 1) % 100;
    }

    match /plantilles/{season} {
      allow read: if isClub();

      // Publicar o sustituir la plantilla de una temporada. Borrar, nunca desde la app.
      allow create, update: if isClub()
        && isSeason(season)
        && request.resource.data.keys().hasOnly(['svg', 'uploadedBy', 'uploadedAt'])
        && request.resource.data.svg is string
        && request.resource.data.svg.size() > 0
        && request.resource.data.svg.size() <= 500000
        && request.resource.data.uploadedBy == request.auth.token.email
        && request.resource.data.uploadedAt == request.time;
    }
  }
}
