{
  "name": "acc",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "vite",
    "dev:carnets": "pnpm --filter acc-carnets dev",
    "dev:all": "pnpm --recursive --include-workspace-root --parallel dev",
    "build": "vue-tsc -b && vite build",
    "build:site": "pnpm build && pnpm build:carnets && node scripts/copy-carnets.mjs",
    "build:carnets": "pnpm --filter acc-carnets build",
    "test:carnets": "pnpm --filter acc-carnets test",
    "preview": "vite preview",
    "deploy": "pnpm build:site && firebase deploy --only hosting",
    "firebase:login": "firebase login",
    "firebase:init": "firebase init hosting"
  },
  "dependencies": {
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}